<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.zx97.SecondRealityAwakened</id>

  <name>Second Reality: Reawakened</name>
  <summary>A modern remaster of the 1993 demoscene classic Second Reality</summary>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <description>
    <p>
      Second Reality: Reawakened is a modern, cross-platform remaster of
      "Second Reality" (1993) by Future Crew, one of the most influential
      demoscene productions ever made. It is built on the C++ port
      Second Reality++ by Jean-Sébastien Royer (XorJS), itself derived from the
      Win32 port by Gargaj / Conspiracy and the original public-domain sources.
    </p>
    <p>
      The same C++ code base runs on Linux (OpenGL ES) and in the browser
      (WebAssembly). Every bitmap and the music are embedded in the binary.
    </p>
  </description>

  <launchable type="desktop-id">io.github.zx97.SecondRealityAwakened.desktop</launchable>

